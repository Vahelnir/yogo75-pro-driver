{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    // No Node types: the core must also run in the browser
    "types": [],
    "noUncheckedSideEffectImports": true
  }
}
